# =====================================================================
# MusicBox Tape Studio — .gitignore
# 目标: 仓库只保留源码/配置/小体积参考数据; 大文件、运行时数据、
#       商业录音与第三方版权内容、私人工具一律不入库。
# =====================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 虚拟环境(各机器自行 `python -m venv .venv` 重建)----
.venv/
venv/

# ---- 本地临时 / 日志 ----
.tmp/
*.log
_*.tmp

# 嘉立创等 CAE 导出日志: 含导出方作者名与本地路径(隐私), 且无设计价值
HardWare_Model/**/*.log

# ---- 运行时数据(体积大; 含用户音频与会话缓存)----
data/sessions/
data/project.json

# ---- 输出目录(生成的 G-code/MIDI/图纸与源音频)----
out/

# ---- 大体积分发产物(1GB 级镜像 tar 等; 用 deploy_server/Dockerfile.portable 自行构建)----
*.tar
*.tar.gz
*.tgz
omnizart-server-*.tar

# ---- 例外: Omnizart 模型权重随仓库分发(约 90MB, 未超 GitHub 单文件 100MB 限制)----
#   checkpoints/ 下的 .pb / .data-00000-of-00001 属于 AI 模型权重, 体积虽大但为运行时必需,
#   故显式保留; 若日后想去掉, 删除下面这行即可(并同步更新 THIRD_PARTY.md §4)。
!third_party/omnizart/checkpoints/**

# ---- 大体积音频素材(Demucs 分轨等; 可由 tools/source_separate.py 重新生成)----
tools/media/stems/
tools/media/*.wav
tools/media/*.mp3

# ---- 第三方版权内容(评测用参考谱面/商业录音派生数据; 详见 THIRD_PARTY.md)----
#   - 从乐谱站抓取的 Verovio SVG 与解析后的谱面 JSON
tools/score_ref/page*.svg
tools/score_ref/xiaye_score.json

# ---- 与本项目无关的私人辅助工具 ----
ncm_tools/

# ---- 3D 打印盘(.3mf)----
#   打印盘里可能包含第三方生成件(如 MakerWorld「压缩弹簧生成器」产出的弹簧), 其许可
#   (Standard Digital File License)禁止再分发数字/3D 版本及其衍生作品 => 默认不入库。
#   若你确认某个 .3mf 只含自绘零件, 可单独取消该文件的忽略。
HardWare_Model/*.3mf

# ---- 系统 / 编辑器 ----
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp
